FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/admin/package.json ./apps/admin/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY apps/reporting/package.json ./apps/reporting/package.json
COPY packages/events/package.json ./packages/events/package.json
COPY packages/money/package.json ./packages/money/package.json
RUN npm ci --workspace @filspay/web --workspace @filspay/admin
COPY . .
ARG VITE_API_BASE_URL
ARG VITE_ADMIN_API_BASE_URL
ARG VITE_WEB_BASE_URL
RUN npm run build --workspace @filspay/web && npm run build --workspace @filspay/admin

FROM nginx:alpine AS merchant
COPY ops/nginx-ui.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html

FROM nginx:alpine AS admin
COPY ops/nginx-ui.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/admin/dist /usr/share/nginx/html
