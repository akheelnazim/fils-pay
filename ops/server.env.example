# Replace all example values on the server; keep the copied file private.
# Percent-encode special characters in database credentials. Single quotes
# prevent Compose from expanding dollar signs in the URL.
DATABASE_URL='postgres://user:password@host.docker.internal:5432/filspay'
SETTLEMENT_INTERNAL_TOKEN=replace-with-random-token
WEBHOOK_SECRET_ENCRYPTION_KEY=replace-with-base64-32-byte-key
ACQUIRER_CALLBACK_SIGNING_SECRET=replace-with-acquirer-signing-secret
CORS_ORIGINS=https://merchant.example.com,https://admin.example.com
CHECKOUT_BASE_URL=https://merchant.example.com
VITE_API_BASE_URL=https://api.example.com

# Public hostnames for the HTTPS proxy.
MERCHANT_DOMAIN=merchant.example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com

# Demo only: true returns OTP codes in login responses and disables the second factor.
OTP_DEV_EXPOSE=false
